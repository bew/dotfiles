#!/usr/bin/env python3

# Report lines longer than a given limit in one or more files.
# Usage: check-long-lines <limit> <file>...
# Output: lines grouped by file; each hit shows 15 chars before the limit,
#         a '┃' marker at the limit column, then the overflow.

from __future__ import annotations

import sys
from pathlib import Path

CONTEXT_CHARS = 15
STDIN_PATH = Path("/dev/stdin")


def print_err(msg: str) -> None:
    print(msg, file=sys.stderr)


def usage_and_exit(status: int) -> None:
    print_err(
        "Usage: check-long-lines <limit> <file>... [-]\n"
        "\n"
        "Report lines that exceed <limit> characters, by file.\n"
        "Pass '-' to read standard input instead of a file\n"
        "('-' may appear at most once)\n"
        "\n"
        "EXAMPLES:\n"
        "  check-long-lines 100 src/foo.ts src/bar.ts\n"
        "  check-long-lines 80 README.md\n"
        "  printf '...' | check-long-lines 80 -"
    )
    sys.exit(status)


def display_source(path: Path) -> str:
    """Return the label for a source: '<stdin>' for stdin, else display_path()."""
    if path == STDIN_PATH:
        return "<stdin>"
    return display_path(path)


def parse_limit(raw: str) -> int:
    """Parse and validate the limit argument."""
    try:
        value = int(raw)
    except ValueError:
        print_err(f"Error: limit must be a positive integer, got: {raw!r}")
        sys.exit(1)
    if value <= 0:
        print_err(f"Error: limit must be a positive integer, got: {value}")
        sys.exit(1)
    return value


def display_path(path: Path) -> str:
    """Return the shortest human-readable form of path.

    Priority: relative to CWD (if nested inside), then ~/... (if under HOME), then absolute.
    """
    abs_path = path.resolve()
    cwd = Path.cwd().resolve()
    home = Path.home().resolve()
    try:
        rel = abs_path.relative_to(cwd)
        return str(rel)
    except ValueError:
        pass
    try:
        rel_home = abs_path.relative_to(home)
        return "~/" + str(rel_home)
    except ValueError:
        pass
    return str(abs_path)


def format_hit(line: str, lineno: int, limit: int) -> str:
    """Build the display string for one over-limit line."""
    start = max(0, limit - CONTEXT_CHARS)
    before = line[start:limit]
    overflow = line[limit:]
    return f"{lineno}: {before}┃{overflow}"


def scan_file(path: Path, limit: int) -> list[str]:
    """Return formatted hit strings for every over-limit line in path."""
    text = path.read_text(encoding="utf-8", errors="replace")
    hits: list[str] = []
    for lineno, line in enumerate(text.splitlines(), start=1):
        # splitlines strips the newline — length is content-only, as intended.
        if len(line) > limit:
            hits.append(format_hit(line, lineno, limit))
    return hits


def main() -> None:
    args = sys.argv[1:]
    if len(args) < 2:
        usage_and_exit(1)

    limit = parse_limit(args[0])

    files: list[Path] = []
    for arg in args[1:]:
        files.append(STDIN_PATH if arg == "-" else Path(arg))
    if files.count(STDIN_PATH) > 1:
        print_err("Error: '- (stdin)' may only appear once")
        sys.exit(1)

    single = len(files) == 1
    errors: list[str] = []
    need_hint = False
    for file in files:
        if not file.exists():
            errors.append(f"Error: file not found: {file}")
            continue

        try:
            hits = scan_file(file, limit)
        except OSError as err:
            errors.append(f"Error: cannot read file {file!r}: {err}")
            continue

        if not single:
            print(f"{display_source(file)}:")
        if hits:
            print("\n".join(hits))
            need_hint = True
        else:
            print("(OK)")
        if not single:
            print()

    if need_hint:
        print(f"('┃' at column {limit})\n")

    if errors:
        for err in errors:
            print_err(err)
        sys.exit(1)


if __name__ == "__main__":
    main()
