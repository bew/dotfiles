#!/usr/bin/env bash

# Update this config's local-plugin dependencies within their declared ranges,
# then report newer versions available outside those ranges (to bump constraints).
# Uses a transient Bun from nixpkgs; safe to run from any directory.

set -euo pipefail

# Nix flake reference for Bun, resolved through the `pkgs` registry alias.
readonly BUN_FLAKE_REF="pkgs#bun"

# Print message to stderr.
function echo_err() {
    echo >&2 "$*"
}

# Print formatted error to stderr and exit 1.
function fail() {
    local msg="$1"
    echo_err "!! ERROR: $msg"
    exit 1
}

# Run Bun from the pinned flake, forwarding all arguments.
function run_bun() {
    nix run "$BUN_FLAKE_REF" -- "$@"
}

# Entry point
function main() {
    if ! command -v nix >/dev/null 2>&1; then
        fail "nix not found on PATH; cannot provision bun."
    fi

    local config_dir
    config_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

    echo_err "Updating local plugin dependencies in $config_dir ..."
    cd -- "$config_dir"
    run_bun update

    echo_err ""
    echo_err "Newer versions available outside current constraints (bump package.json to adopt):"
    run_bun outdated
}

main "$@"