// DOC: https://opencode.ai/v2/docs/
{
  "$schema": "https://opencode.ai/config.json",

  // Updates are fully managed by Nix, OC can't do anything about it
  "autoupdate": false,

  "default_agent": "plan",
  "small_model": "opencode/big-pickle", // Free model (not very smart..)

  "permissions": [
    // BAD: OC removed the default rule to ask before doing anything in non-current directory 🤬
    // TRACKING: https://github.com/anomalyco/opencode/issues/54524
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  "experimental": {
    // Allow nested subagents, e.g: reviewer (depth 1) spawns simulated-test-runner (depth 2).
    // Default is 1, which would block that.
    // Using 5 leaves headroom for deeper nesting needs ;)
    "subagent_depth": 5,
  },

  "plugins": [
    // Plugin for Dynamic Context Pruning
    // see: https://github.com/Opencode-DCP/opencode-dynamic-context-pruning
    // Gives /dcp command, but should be used automatically by the models
    "@tarquinen/opencode-dcp@latest",
    // Plugin for #foo snippet expansion in prompt, very flexible!
    // see: https://github.com/JosXa/opencode-snippets
    // NOTE: need to have the same in `tui.jsonc` for completions in TUI
    "opencode-snippets@latest"
  ]
}
